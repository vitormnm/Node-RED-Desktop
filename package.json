{
  "name": "Node-RED-Desktop",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "prod": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev": "cross-env NODE_ENV=dev concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "build64": "npm run build && electron-packager . NodeRedDesktop --icon=./electron/resources/nodered.ico --platform=win32 --arch=x64 --out=build --asar --overwrite --win32metadata.CompanyName=VitorMiao --win32metadata.ProductName='Node-RED-Desktop' --prune=true --ignore=\"^/(src|installer|WinSW|public|vite\\.config\\.js|package-lock\\.json|\\.git|\\.vscode|\\.gitignore|\\.gitattributes|\\.npmignore|AGENTS\\.md|README\\.md)\" && xcopy WinSW build\\NodeRedDesktop-win32-x64\\WinSW\\ /E /I /Y",
    "build64linux": "npm run build && electron-packager . NodeRedDesktop --icon=./electron/resources/nodered.ico --platform=linux --arch=x64 --out=build --asar --overwrite --win32metadata.CompanyName=VitorMiao --win32metadata.ProductName='Node-RED-Desktop' --prune=true --ignore=\"^/(src|installer|WinSW|public|vite\\.config\\.js|package-lock\\.json|\\.git|\\.vscode|\\.gitignore|\\.gitattributes|\\.npmignore|AGENTS\\.md|README\\.md)\""
  },
  "dependencies": {
    "node-red": "5.0.9"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.3",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "unplugin-fonts": "2.1.0",
    "vite": "8.3.6",
    "wait-on": "9.5.1",
    "vue": "3.5.45",
    "vue-router": "4.6.4",
    "vuetify": "4.3.2",
    "@fontsource/roboto": "5.3.0",
    "@mdi/font": "7.4.47"
  }
}
